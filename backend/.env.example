DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# gere com: npx @better-auth/cli secret  (ou openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# chave do HMAC do cpf; se mudar, os hashes existentes deixam de bater
CPF_HASH_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# busca (Elasticsearch alimentado pelo Sequin); se estiver fora, so as rotas de busca respondem 503
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
# intervalo do job que recalcula event.available_tickets (ms); 0 desliga
AVAILABILITY_REFRESH_INTERVAL_MS=10000
