DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# gere com: npx @better-auth/cli secret  (ou openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# chave do HMAC do cpf; se mudar, os hashes existentes deixam de bater
CPF_HASH_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- observabilidade (ver README) ---
# Lidas pelo src/instrumentation.ts, que roda antes do app: por isso os scripts carregam este .env com --env-file-if-exists.
# Coletor OTLP/HTTP (Grafana Alloy do docker-compose). Default: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true desliga traces, métricas e o envio de logs (o app continua logando no terminal)
# OTEL_SDK_DISABLED=false
# intervalo de envio das métricas em ms. Default: 15000
# OTEL_METRIC_EXPORT_INTERVAL=15000
# diagnóstico do próprio SDK (ex.: falha ao exportar): none|error|warn|info|debug
# OTEL_LOG_LEVEL=error
# nível do pino: trace|debug|info|warn|error|fatal|silent. Default: info (silent nos testes)
# LOG_LEVEL=info
# production: logs em JSON puro (sem pino-pretty) e deployment.environment=production
# NODE_ENV=development
