DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# gere com: npx @better-auth/cli secret  (ou openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# chave do HMAC do cpf; se mudar, os hashes existentes deixam de bater
CPF_HASH_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# callback: {BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- observabilidade (ver README) ---
# Lidas pelo src/instrumentation.ts, que roda antes do app: por isso os scripts carregam este .env com --env-file-if-exists.
# Coletor OTLP/HTTP (Grafana Alloy do docker-compose). Default: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true desliga traces, métricas e o envio de logs (o app continua logando no terminal)
# OTEL_SDK_DISABLED=false
# intervalo de envio das métricas em ms. Default: 15000
# OTEL_METRIC_EXPORT_INTERVAL=15000
# diagnóstico do próprio SDK (ex.: falha ao exportar): none|error|warn|info|debug
# OTEL_LOG_LEVEL=error
# nível do pino: trace|debug|info|warn|error|fatal|silent. Default: info (silent nos testes)
# LOG_LEVEL=info
# production: logs em JSON puro (sem pino-pretty) e deployment.environment=production
# NODE_ENV=development

# busca (Elasticsearch alimentado pelo Sequin); se estiver fora, so as rotas de busca respondem 503
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
# intervalo do job que recalcula event.available_tickets (ms); 0 desliga
AVAILABILITY_REFRESH_INTERVAL_MS=10000

# --- pagamento: Mercado Pago, Checkout Pro via API de Orders (ver README, "Pagamento") ---
# Access token da aplicação (painel > Suas integrações > Credenciais). Em dev, use as credenciais
# de TESTE. Só o backend usa; nunca vai para o front nem para logs. Vazio: a API sobe, mas o
# checkout e o webhook respondem 502.
MP_ACCESS_TOKEN=
# Public key: não é usada pelo backend (o Checkout Pro redireciona para a página do Mercado Pago);
# fica aqui só para referência caso um dia o front use o SDK JS.
MP_PUBLIC_KEY=
# Assinatura secreta do webhook. É gerada no painel (Webhooks > Configurar notificações) depois de
# cadastrar a URL de notificação. VAZIO = toda notificação é recusada com 401 (fail closed).
MP_WEBHOOK_SECRET=
# URL pública do webhook, para cadastrar no painel (evento "Order (Mercado Pago)"). Não é enviada
# na order: a API de Orders do Checkout Pro não tem campo de notification_url por pedido. Em dev,
# a URL do túnel: https://<algo>.trycloudflare.com/webhooks/mercadopago
# MP_NOTIFICATION_URL=
# Tolerância (s) entre o `ts` da assinatura e o relógio do servidor; fora disso é replay. Default: 300
# MP_WEBHOOK_TOLERANCE_SECONDS=300
# Timeout (ms) de cada chamada à API do Mercado Pago, 1 a 15000. Default: 5000
# MP_HTTP_TIMEOUT_MS=5000
# Só para testes (e2e aponta para uma porta fechada). Default: https://api.mercadopago.com
# MP_API_BASE_URL=https://api.mercadopago.com
# As URLs de retorno do checkout são montadas a partir do FRONTEND_URL (acima):
#   {FRONTEND_URL}/payment/success|pending|failure?payment_id=<id>

# --- imagens: S3 ou compatível (ver README, "Armazenamento de imagens") ---
# O navegador envia direto ao bucket (POST pré-assinado); a API só assina e confere.
# Em dev: LocalStack do docker-compose (infra/storage). Trocar de provedor é só mudar estas variáveis.
STORAGE_S3_BUCKET=bilheteria-images
STORAGE_S3_REGION=us-east-1
# Vazio = AWS S3. LocalStack/MinIO/R2: a URL do serviço (o navegador também precisa alcançá-la).
STORAGE_S3_ENDPOINT=http://localhost:4566
# true para LocalStack/MinIO (http://host/bucket/chave); false na AWS (virtual-hosted)
STORAGE_S3_FORCE_PATH_STYLE=true
# Vazias = cadeia padrão da AWS (AWS_ACCESS_KEY_ID..., perfil, role). O LocalStack aceita test/test.
STORAGE_S3_ACCESS_KEY_ID=test
STORAGE_S3_SECRET_ACCESS_KEY=test
# Base das URLs servidas ao front (bucket público, CloudFront, domínio do R2...); a chave do objeto
# é anexada a ela. Vazia: derivada do endpoint/bucket.
STORAGE_PUBLIC_URL=http://localhost:4566/bilheteria-images

# --- emails transacionais (módulo notification; ver README, "Emails") ---
# Remetente. Sem domínio verificado no Resend só vale onboarding@resend.dev, e o Resend só
# entrega para o email da própria conta (outros destinatários: 403, o email vira "failed").
# Com domínio: "Bilheteria <ingressos@seudominio.com.br>".
EMAIL_FROM="Bilheteria <onboarding@resend.dev>"
# Obrigatória (a API não sobe sem ela). Painel do Resend > API Keys ("Sending access"). Segredo.
RESEND_API_KEY=
# Intervalo (ms) do worker que envia a outbox. Default: 5000; 0 desliga o envio.
# EMAIL_DISPATCH_INTERVAL_MS=5000
# Intervalo (ms) do agendador do aviso "vendas abrem em 1 hora" (favoritos). Default: 60000; 0 desliga.
# SALES_OPENING_INTERVAL_MS=60000
