generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // índices únicos parciais do payment (no máximo um aprovado / um pendente por ticket)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
  ORGANIZER
}

model ticket{
    id Int @id @default(autoincrement())
    user_id String?
    user user? @relation(fields: [user_id], references: [id])
    reserved_at DateTime?
    is_paid Boolean @default(false)
    event_id Int
    event event @relation(fields: [event_id], references: [id])
    payments payment[]
    created_at DateTime @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    @@index([user_id, event_id])
    @@index([event_id])
}

model event{
    id Int @id @default(autoincrement())
    name String
    description String?
    location String
    starts_at DateTime
    capacity Int
    // preço único do ingresso, em centavos de BRL (CHECK > 0 na migration). Nulo só nos eventos
    // criados antes do pagamento: ficam sem venda até ganharem um preço (o checkout recusa).
    price_cents Int?
    // quantos ingressos ativos (pagos ou com reserva vigente) um mesmo CPF pode ter neste evento;
    // escolhido pelo organizador na criação (1..10, CHECK na migration). Eventos antigos ficam com 2.
    max_tickets_per_cpf Int @default(2)
    // contador aproximado para a busca: recalculado em lote pelo job de disponibilidade
    // (o numero exato continua vindo do /status/:id, que conta os tickets)
    available_tickets Int @default(0)
    // chave do objeto da capa no bucket (events/<id>/cover/<uuid>.<ext>). Só a chave: a URL
    // pública é montada com STORAGE_PUBLIC_URL, então trocar de provedor não mexe no banco.
    cover_key String?
    organizer_id String
    organizer user @relation(fields: [organizer_id], references: [id])
    tickets ticket[]
    photos event_photo[]
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([starts_at])
}

// Galeria do evento (até 10 fotos, limite garantido com a linha do evento travada).
// `position` ordena a galeria; única por evento (reordenar passa por posições negativas).
model event_photo {
    id         Int      @id @default(autoincrement())
    event_id   Int
    event      event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
    // events/<id>/photos/<uuid>.<ext>; gerada pelo servidor, nunca pelo nome do arquivo do cliente
    key        String   @unique
    position   Int
    created_at DateTime @default(now())

    @@unique([event_id, position])
}
model user {
    id            String    @id
    name          String
    email         String    @unique
    emailVerified Boolean   @default(false) @map("email_verified")
    // foto do provedor social (Google/Facebook); continua sendo a padrão até o usuário enviar a dele
    image         String?
    // avatar enviado pelo usuário (users/<id>/avatar/<uuid>.<ext>); servido no lugar de `image`
    avatarKey     String?   @map("avatar_key")
    role          Role      @default(USER)
    cpfHash       String?   @unique @map("cpf_hash")
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @updatedAt @map("updated_at")
    sessions      session[]
    accounts      account[]
    tickets       ticket[]
    events        event[]
    payments      payment[]

    @@map("users")
}

model session {
    id        String   @id
    expiresAt DateTime @map("expires_at")
    token     String   @unique
    ipAddress String?  @map("ip_address")
    userAgent String?  @map("user_agent")
    userId    String   @map("user_id")
    user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([userId])
    @@map("sessions")
}

model account {
    id                    String    @id
    accountId             String    @map("account_id")
    providerId            String    @map("provider_id")
    userId                String    @map("user_id")
    user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?   @map("access_token")
    refreshToken          String?   @map("refresh_token")
    idToken               String?   @map("id_token")
    accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
    refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now()) @map("created_at")
    updatedAt             DateTime  @updatedAt @map("updated_at")

    @@index([userId])
    @@map("accounts")
}

model verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime @map("expires_at")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    @@index([identifier])
    @@map("verifications")
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  expired
  refunded
}

// Uma tentativa de pagamento de um ticket num provedor (hoje só o Mercado Pago).
// O id (uuid) vai como external_reference para o provedor.
model payment {
    id                  String        @id @default(uuid())
    ticket_id           Int
    ticket              ticket        @relation(fields: [ticket_id], references: [id])
    user_id             String
    user                user          @relation(fields: [user_id], references: [id])
    amount_cents        Int
    currency            String        @default("BRL")
    status              PaymentStatus @default(pending)
    provider            String
    provider_order_id   String?
    provider_payment_id String?
    checkout_url        String?
    // fim da reserva paga por este checkout (identifica a reserva: reserved_at + TTL)
    expires_at          DateTime
    created_at          DateTime      @default(now())
    updated_at          DateTime      @updatedAt

    // idempotência pelos ids do provedor: a mesma order/pagamento nunca vira duas linhas
    @@unique([provider, provider_order_id])
    @@unique([provider, provider_payment_id])
    // no máximo UM pagamento aprovado por ticket: o mesmo ingresso nunca é vendido duas vezes
    @@unique([ticket_id], map: "payment_one_approved_per_ticket", where: {status: "approved"})
    // no máximo um checkout pendente por ticket: o checkout é reaproveitado, não duplicado
    @@unique([ticket_id], map: "payment_one_pending_per_ticket", where: {status: "pending"})
    @@index([ticket_id, status])
    @@index([user_id])
}
