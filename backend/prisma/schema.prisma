generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
  ORGANIZER
}

model ticket{
    id Int @id @default(autoincrement())
    user_id String?
    user user? @relation(fields: [user_id], references: [id])
    reserved_at DateTime?
    is_paid Boolean @default(false)
    event_id Int
    event event @relation(fields: [event_id], references: [id])
    created_at DateTime @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    @@index([user_id, event_id])
    @@index([event_id])
}

model event{
    id Int @id @default(autoincrement())
    name String
    description String?
    location String
    starts_at DateTime
    capacity Int
    // contador aproximado para a busca: recalculado em lote pelo job de disponibilidade
    // (o numero exato continua vindo do /status/:id, que conta os tickets)
    available_tickets Int @default(0)
    organizer_id String
    organizer user @relation(fields: [organizer_id], references: [id])
    tickets ticket[]
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([starts_at])
}
model user {
    id            String    @id
    name          String
    email         String    @unique
    emailVerified Boolean   @default(false) @map("email_verified")
    image         String?
    role          Role      @default(USER)
    cpfHash       String?   @unique @map("cpf_hash")
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @updatedAt @map("updated_at")
    sessions      session[]
    accounts      account[]
    tickets       ticket[]
    events        event[]

    @@map("users")
}

model session {
    id        String   @id
    expiresAt DateTime @map("expires_at")
    token     String   @unique
    ipAddress String?  @map("ip_address")
    userAgent String?  @map("user_agent")
    userId    String   @map("user_id")
    user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([userId])
    @@map("sessions")
}

model account {
    id                    String    @id
    accountId             String    @map("account_id")
    providerId            String    @map("provider_id")
    userId                String    @map("user_id")
    user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?   @map("access_token")
    refreshToken          String?   @map("refresh_token")
    idToken               String?   @map("id_token")
    accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
    refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now()) @map("created_at")
    updatedAt             DateTime  @updatedAt @map("updated_at")

    @@index([userId])
    @@map("accounts")
}

model verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime @map("expires_at")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    @@index([identifier])
    @@map("verifications")
}
