      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(bilheteria_payments_confirmed_total{job=\"bilheteria-backend\"}[$__range])) / sum(increase(bilheteria_reservations_total{job=\"bilheteria-backend\", outcome=\"reserved\"}[$__range]))",
          "instant": true,
          "range": false
