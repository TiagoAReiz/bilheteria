{
  "_meta": {
    "description": "Eventos para busca pública. Documento montado pela transform infra/search/sequin/transforms/event-document.exs",
    "version": 2
  },
  "index_patterns": ["events_v*"],
  "composed_of": ["bilheteria-analysis"],
  "priority": 200,
  "template": {
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "search_as_you_type", "analyzer": "pt_br_folded" },
        "name_stemmed": { "type": "text", "analyzer": "pt_br" },
        "description": { "type": "text", "analyzer": "pt_br" },
        "location": {
          "type": "text",
          "analyzer": "pt_br",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 256 }
          }
        },
        "starts_at": { "type": "date" },
        "capacity": { "type": "integer" },
        "available_tickets": { "type": "integer" },
        "cover_key": { "type": "keyword", "index": false, "doc_values": false },
        "organizer_id": { "type": "keyword" },
        "deleted": { "type": "boolean" }
      }
    }
  }
}
